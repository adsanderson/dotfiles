# Keep generated titles compact and preserve the numbered tab shortcuts.
HERDR_AUTO_TITLE_MAX_LENGTH=50
HERDR_AUTO_TITLE_BRANCH_MAX=12
HERDR_AUTO_TITLE_POSITION=true

# Prefer an agent's task over the focused editor pane in split layouts.
HERDR_AUTO_TITLE_TRANSCRIPT=true
HERDR_AUTO_TITLE_AGENT_NAME=false
HERDR_AUTO_TITLE_PANES=true
HERDR_AUTO_TITLE_PREFER_AGENT=true
HERDR_AUTO_TITLE_PANE_ID=false

# This setup does not render the optional workspace topic row.
HERDR_AUTO_TITLE_WORKSPACES=false
