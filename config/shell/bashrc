# Portable interactive shell configuration.
[[ $- == *i* ]] || return

export EDITOR="${EDITOR:-nvim}"
export VISUAL="${VISUAL:-$EDITOR}"
export SUDO_EDITOR="${SUDO_EDITOR:-$EDITOR}"
export BAT_THEME="${BAT_THEME:-ansi}"
export MANROFFOPT="${MANROFFOPT:--c}"
export MANPAGER="${MANPAGER:-sh -c 'col -bx | bat -l man -p'}"

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi
if command -v fzf >/dev/null 2>&1; then
  eval "$(fzf --bash)"
fi
if [[ ${TERM:-} != dumb ]] && command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

source "$HOME/dotfiles/config/shell/aliases.sh"
source "$HOME/dotfiles/config/shell/functions.sh"
if command -v herdr >/dev/null 2>&1; then
  source "$HOME/dotfiles/config/shell/herdr.sh"
fi
if command -v pnpm >/dev/null 2>&1; then
  source "$HOME/dotfiles/config/shell/completions/pnpm.bash"
fi
